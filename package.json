{
  "name": "playwright-with-ts",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright automation framework with TypeScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui:tests": "playwright test -c tests/ui",
    "test:api:tests": "playwright test -c tests/api",
    "test:chrome": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:serial": "playwright test --workers=1",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen",
    "test:trace": "playwright show-trace",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit",
    "dev": "concurrently \"npm run dev:app\" \"npm run dev:api\"",
    "dev:app": "echo 'Starting app...'",
    "dev:api": "echo 'Starting API...'"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "typescript",
    "e2e",
    "api",
    "page-object-model"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
